# Copy this file to .env and fill in your values before running docker compose.
#   cp .env.example .env

# ── HTTP port ────────────────────────────────────────────────────────────────
# Port exposed on the host. Change if 80 is already in use.
HTTP_PORT=80

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pcapbloodhound
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pcapbloodhound

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random value for production:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# ── Demo mode ─────────────────────────────────────────────────────────────────
# true  → no login required, upload disabled, 5 sample captures pre-loaded
# false → full app with OAuth login and file upload
DEMO_MODE=true

# ── Frontend URL ─────────────────────────────────────────────────────────────
# Base URL where the app is reachable. Used for OAuth redirect URIs.
# Include the port if not using 80/443.
FRONTEND_URL=http://localhost

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200

# ── OAuth — Microsoft 365 (leave blank if not using) ─────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── OAuth — Google Workspace (leave blank if not using) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of allowed email domains (full app mode only).
# Leave blank to allow any domain.
ALLOWED_DOMAINS=
